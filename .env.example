# ════════════════════════════════════════════════════════
# GTM Intelligence Platform — Environment Variables
# ════════════════════════════════════════════════════════

# ── Google Gemini (FREE — PRIMARY AI LAYER) ──────────────
# Free tier: 1,500 req/day, 1M tokens/min
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── GitHub (FREE with token — 5000 req/hr) ───────────────
# Get free token: https://github.com/settings/tokens
# Scopes needed: public_repo (read-only)
GITHUB_TOKEN=ghp_your_github_token_here

# ── Bright Data (PAID — $250 budget, used as FALLBACK) ───
# Only invoked when free APIs fail or are blocked
# Get credentials: https://brightdata.com
BRIGHT_DATA_USERNAME=brd-customer-XXXXXXXX-zone-web_unlocker
BRIGHT_DATA_PASSWORD=your_bright_data_password
BRIGHT_DATA_HOST=brd.superproxy.io
BRIGHT_DATA_CUSTOMER_ID=XXXXXXXX
WEB_UNLOCKER_PORT=22225
SERP_API_PORT=22226

# CDP endpoint for Scraping Browser (Playwright)
# Only used for truly JS-heavy pages ($0.10/session)
SCRAPING_BROWSER_CDP_URL=wss://brd.superproxy.io:9222

# Hard budget cap — rejects BD requests when exceeded
BRIGHT_DATA_BUDGET_USD=250.0

# ── SecurityTrails (OPTIONAL PAID — skip if no key) ──────
# Skip this if you don't have a key — 5 free sources cover it
SECURITY_TRAILS_API_KEY=

# ── Output / Delivery ─────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
HUBSPOT_API_KEY=your_hubspot_api_key

# ── Storage ───────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/gtm_intel

# ── Async workers (Redis + Celery) ────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Collector tuning ──────────────────────────────────────
CT_POLL_INTERVAL=300
WAYBACK_DIFF_WINDOW_DAYS=30
GITHUB_SPIKE_THRESHOLD=10
WAYBACK_MAX_SNAPSHOTS=50
MAX_CONCURRENT_COLLECTORS=10

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "GTM Backend (FastAPI)",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["stage6.backend.main:app", "--reload", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "GTM Frontend (Vite + React)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "stage6/frontend", "run", "dev"],
      "port": 5173
    }
  ]
}
